# ---------------------------------------------------------------------------
# ABYNÉA — Variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` et renseignez vos valeurs.
# L'application fonctionne SANS aucune variable (mode démo) : le paiement est
# alors simulé et le parcours client reste 100% fonctionnel.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# STRIPE — Carte bancaire, Apple Pay, Google Pay, Link
# ---------------------------------------------------------------------------
# Clé publique (navigateur) : https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Clé secrète (serveur uniquement — ne jamais exposer côté client)
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# PAYPAL — Paiement express
# ---------------------------------------------------------------------------
# Client ID de l'application (sandbox ou live) : https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# URL publique du site (utilisée pour le sitemap, robots.txt et les redirections de paiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
