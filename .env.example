# ---------------------------------------------------------------------------
# ABYNÉA — Variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` et renseignez vos valeurs.
# L'application fonctionne SANS aucune variable (mode démo) : le paiement est
# alors simulé et le parcours client reste 100% fonctionnel.
# ---------------------------------------------------------------------------

# Stripe — clé secrète (test ou live). Si absente, le paiement est simulé.
# Obtenez une clé test sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# URL publique du site (utilisée pour le sitemap, robots.txt et les redirections Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
